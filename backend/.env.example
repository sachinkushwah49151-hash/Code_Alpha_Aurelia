# ==============================================================================
# AURELIA Django Backend — Environment Configuration Template
# Copy this file to .env and configure for your environment.
# NEVER commit the real .env file or production secrets to Git.
# ==============================================================================

# ── Django Core Security ──────────────────────────────────────────────────────
# In production: Generate a random 50+ character string. Must NOT start with 'django-insecure-'.
# Required when DEBUG=False.
SECRET_KEY=django-insecure-dev-key-change-in-production-before-deploying

# Set to False in production. Set to True only for local development.
DEBUG=True

# Comma- or space-separated list of allowed hostnames/domains.
# Required when DEBUG=False. Example: api.aurelia.co,aurelia-backend.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database Configuration (PostgreSQL / SQLite) ─────────────────────────────
# OPTION A: Single Hosted Database URL (Required on Render, Neon, Supabase, Railway)
# MANDATORY in production when DEBUG=False. Overrides DB_* parameters.
# Render automatically injects this when connected to a PostgreSQL database.
# DATABASE_URL=postgresql://user:password@dpg-sample.oregon-postgres.render.com/aurelia_db?sslmode=require

# OPTION B: Discrete Database Parameters
# If DATABASE_URL is not set, the backend inspects DB_NAME.
# DB_NAME=aurelia_db
# DB_USER=postgres
# DB_PASSWORD=your_secure_database_password
# DB_HOST=localhost
# DB_PORT=5432
# DB_SSLMODE=require

# OPTION C: Local SQLite Fallback (DEBUG=True ONLY)
# If BOTH DATABASE_URL and DB_NAME are empty, the backend uses db.sqlite3 in local development.
# NOTE: In production (DEBUG=False), SQLite fallback is STRICTLY PROHIBITED and will raise ImproperlyConfigured.
DB_NAME=

# Connection Pooling (seconds to keep DB connections open; recommended 600 for hosted DBs)
DB_CONN_MAX_AGE=600

# ── CORS Configuration ────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (NO trailing slashes).
# In production, replace with your frontend URL(s).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── JWT Authentication (SimpleJWT) ───────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Production HTTPS & Reverse Proxy Settings (Active only when DEBUG=False) ──
# Set to True if Django should redirect all HTTP requests to HTTPS.
# Leave False if your cloud host (e.g. Render/Cloudflare) already handles SSL termination.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

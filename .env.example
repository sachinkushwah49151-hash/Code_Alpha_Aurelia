# AURELIA Frontend Environment Configuration
# Local development:
# Points to local Django REST Framework backend on port 8000
VITE_API_BASE_URL=http://127.0.0.1:8000/api/
VITE_API_URL=http://127.0.0.1:8000/api

# Render unified deployment (React + Django together on ONE service):
# In production, VITE_API_BASE_URL defaults to relative '/api' automatically,
# so all requests route to the same domain without CORS or domain configuration.
# VITE_API_BASE_URL=/api

# Set to false to connect to the live Django backend (default)
# Set to true only for standalone frontend prototype testing without backend
VITE_USE_MOCK=false
